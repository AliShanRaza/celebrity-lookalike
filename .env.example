# Environment Configuration Placeholder for Celebrity Look-Alike Monorepo
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=change_this_to_a_secure_secret_in_production

# PostgreSQL & pgvector Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=celebrity_lookalike
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy Async/Sync Database URLs
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
ASYNC_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# FastAPI Backend Settings
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Web Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000
