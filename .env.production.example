# Production Environment & Security Configuration Example
# Copy to .env.production on production hosts. DO NOT commit actual secrets to version control.

# App Environment & Versioning
APP_ENV=production
APP_VERSION=0.1.0
BUILD_SHA=git-sha-commit-hash-here
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_64_CHAR_SECRET_KEY

# External Managed Database (AWS Aurora PostgreSQL / GCP Cloud SQL / Azure Database)
POSTGRES_USER=app_db_user
POSTGRES_PASSWORD=SECURE_DB_PASSWORD_HERE
POSTGRES_DB=celebrity_lookalike_prod
POSTGRES_HOST=managed-postgres.prod.internal
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=verify-full

# External Managed Redis (AWS ElastiCache / GCP MemoryStore / Redis Cloud)
REDIS_URL=rediss://:SECURE_REDIS_PASSWORD@managed-redis.prod.internal:6379/0

# Private S3-Compatible Object Storage (AWS S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT=https://s3.us-west-2.amazonaws.com
S3_BUCKET_NAME=prod-celebrity-lookalike-reference-images
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# API & Security Rate Limiting
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=https://lookalike.yourdomain.com,https://app.yourdomain.com

# Machine Learning Model Configuration (Read-only volume mount)
RECOGNITION_PROVIDER=real
EMBEDDING_DIMENSION=512
MODEL_WEIGHTS_PATH=/models/w600k_mbf.onnx
MODEL_LICENSE_PATH=/models/MODEL_LICENSE.txt
REAL_MODEL_VERSION=real_v1

# Security Feature Flags
ENABLE_URL_UPLOADS=false
ASYNC_MATCHING_ENABLED=true
MAX_QUEUE_CAPACITY=200
JOB_RESULT_TTL_SECONDS=600
JOB_TIMEOUT_SECONDS=30
MAX_TRANSIENT_RETRIES=3
